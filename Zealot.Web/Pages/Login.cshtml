@page
@model Zealot.Web.Pages.LoginModel
@{
    ViewData["Title"] = "Login";
}

<section class="auth-shell" aria-labelledby="login-title">
    <div class="auth-panel">
        <p class="eyebrow">Secure access</p>
        <h1 id="login-title">Login with Discord</h1>
        <p>
            Connect your Discord account to manage Zealot settings for servers where you have the right permissions.
        </p>

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="auth-alert" role="alert">@Model.ErrorMessage</div>
        }

        <form method="post">
            <button class="btn btn-zealot" type="submit">Continue with Discord</button>
        </form>
    </div>
</section>
